    {
      "id": 10,
      "title": "妻との会話",
      "background": "home_living",
      "bgm": "daily",
      "cuts": [
        { "id": "s10_01", "speaker": "ichiko", "text": "お父さん、最近少し顔色が良くなったんじゃない？", "characters": ["kazuo", "ichiko"], "expressions": [{"id": "kazuo", "position": "left", "expression": "kazuo_general_05_neutral"}, {"id": "ichiko", "position": "right", "expression": "ichiko_01_smile"}] },
        { "id": "s10_02", "speaker": "kazuo", "text": "そうか？山田さんが来てくれるようになって、お風呂にも入れるし、リハビリもできるからかな。", "characters": ["kazuo", "ichiko"], "expressions": [{"id": "kazuo", "position": "left", "expression": "kazuo_general_02_worried"}, {"id": "ichiko", "position": "right", "expression": "ichiko_05_neutral"}] },
        { "id": "s10_03", "speaker": "ichiko", "text": "私も安心できるわ。一人で見ていた時は、夜中に何かあったらどうしようって心配で。", "characters": ["kazuo", "ichiko"], "expressions": [{"id": "kazuo", "position": "left", "expression": "kazuo_general_05_neutral"}, {"id": "ichiko", "position": "right", "expression": "ichiko_02_worried"}] },
        { "id": "s10_04", "speaker": "kazuo", "text": "母さんには苦労をかけるな。", "characters": ["kazuo", "ichiko"], "expressions": [{"id": "kazuo", "position": "left", "expression": "kazuo_general_02_worried"}, {"id": "ichiko", "position": "right", "expression": "ichiko_05_neutral"}] },
        { "id": "s10_05", "speaker": "ichiko", "text": "何言ってるの。一緒にいられる時間を大切にしましょうよ。", "characters": ["kazuo", "ichiko"], "expressions": [{"id": "kazuo", "position": "left", "expression": "kazuo_general_05_neutral"}, {"id": "ichiko", "position": "right", "expression": "ichiko_01_smile"}] },
        { "id": "s10_06", "speaker": "kazuo", "text": "ああ、そうだな。来月、孫が遊びに来るって言ってたな。その日を楽しみにしているよ。", "characters": ["kazuo", "ichiko"], "expressions": [{"id": "kazuo", "position": "left", "expression": "kazuo_general_01_smile"}, {"id": "ichiko", "position": "right", "expression": "ichiko_05_neutral"}] },
        { "id": "s10_07", "speaker": "ichiko", "text": "近場でいいじゃない。孫たちも連れて、みんなで美味しいもの食べに行きましょう。", "characters": ["kazuo", "ichiko"], "expressions": [{"id": "kazuo", "position": "left", "expression": "kazuo_general_01_smile"}, {"id": "ichiko", "position": "right", "expression": "ichiko_01_smile"}] },
        { "id": "s10_08", "speaker": "kazuo", "text": "そうだな。それを目標に、リハビリも頑張るよ。", "characters": ["kazuo", "ichiko"], "expressions": [{"id": "kazuo", "position": "left", "expression": "kazuo_general_09_grateful"}, {"id": "ichiko", "position": "right", "expression": "ichiko_01_smile"}] }
      ],
