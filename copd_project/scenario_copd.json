  "scenes": [
    {
      "id": 1,
      "title": "イントロ",
      "background": "map_town",
      "bgm": "main_theme",
      "cuts": [
        { "id": "s01_01", "speaker": "narration", "text": "今回の主人公は聖隷一男さん、78歳の男性です。元公務員で、定年後は妻の市子さんとゴルフや旅行を楽しんでいました。", "expressions": [] },
        { "id": "s01_02", "speaker": "narration", "text": "3年前にCOPD、慢性閉塞性肺疾患と診断され、在宅酸素療法を開始。先月、コロナ感染から急性増悪を起こし入院しましたが、退院して自宅療養を始めたところです。", "expressions": [] },
        { "id": "s01_03", "speaker": "narration", "text": "一男さんの視点で、訪問看護や地域の多職種連携を体験してみましょう。", "expressions": [] }
      ],
      "knowledge": {
        "title": "COPDとは",
        "text": "COPD（Chronic Obstructive Pulmonary Disease）は、タバコ煙などの有害物質を長期に吸入することで生じる肺の炎症性疾患です。\n\n・肺胞の破壊（肺気腫）と気道の炎症により気流制限が生じる\n・日本では約530万人以上の患者がいると推定\n・主な症状：息切れ、慢性的な咳・痰\n・喫煙が最大の危険因子"
      }
    },
    {
      "id": 2,
      "title": "退院前カンファ",
      "background": "hospital_room",
      "bgm": "medical",
      "cuts": [
        { "id": "s02_01", "speaker": "doctor", "text": "聖隷さん、入院中の治療で心不全の症状は改善しました。ただ、肺の状態は以前より悪化しています。", "characters": ["kazuo", "doctor"], "expressions": [{"id": "kazuo", "position": "left", "expression": "kazuo_general_02_worried"}, {"id": "doctor", "position": "right", "expression": "doctor_07_serious"}] },
        { "id": "s02_02", "speaker": "kazuo", "type": "thought", "text": "やっぱり悪くなっているのか。でも家に帰りたい。", "characters": ["kazuo", "doctor"], "expressions": [{"id": "kazuo", "position": "left", "expression": "kazuo_general_04_thinking"}, {"id": "doctor", "position": "right", "expression": "doctor_05_neutral"}] },
        { "id": "s02_03", "speaker": "doctor", "text": "夜間のNPPV、非侵襲的陽圧換気療法を自宅でも続けることをお勧めしますが、いかがですか？", "characters": ["kazuo", "doctor"], "expressions": [{"id": "kazuo", "position": "left", "expression": "kazuo_general_02_worried"}, {"id": "doctor", "position": "right", "expression": "doctor_04_thinking"}] },
        { "id": "s02_04", "speaker": "kazuo", "text": "先生、あの機械は眠れないし、つけるのも大変で。酸素だけでなんとかなりませんか？", "characters": ["kazuo", "doctor"], "expressions": [{"id": "kazuo", "position": "left", "expression": "kazuo_general_02_worried"}, {"id": "doctor", "position": "right", "expression": "doctor_05_neutral"}] },
        { "id": "s02_05", "speaker": "doctor", "text": "ご本人の意思を尊重します。ただ、急性増悪のリスクは高いことをご理解ください。何かあったらすぐに連絡してください。", "characters": ["kazuo", "doctor"], "expressions": [{"id": "kazuo", "position": "left", "expression": "kazuo_general_05_neutral"}, {"id": "doctor", "position": "right", "expression": "doctor_07_serious"}] },
        { "id": "s02_06", "speaker": "kazuo", "text": "わかりました。悪くなるなら、それも寿命かなと思っています。", "characters": ["kazuo", "doctor"], "expressions": [{"id": "kazuo", "position": "left", "expression": "kazuo_general_07_serious"}, {"id": "doctor", "position": "right", "expression": "doctor_02_worried"}] }
      ],
      "knowledge": {
        "title": "NPPVとは",
        "text": "NPPV（非侵襲的陽圧換気療法）は、マスクを介して陽圧をかけ呼吸を補助する治療法です。\n\n・気管挿管が不要なため「非侵襲的」\n・COPD急性増悪時の第一選択治療\n・マスクの不快感から継続が難しい患者も\n・患者の意思決定を尊重することが重要"
      },
      "quiz": {
        "question": "COPD急性増悪時の人工呼吸管理として、最初に選択されることが多いのはどれか？",
        "options": [
          { "text": "気管挿管による人工呼吸", "correct": false },
          { "text": "NPPV（非侵襲的陽圧換気療法）", "correct": true },
          { "text": "高流量鼻カニュラ酸素療法", "correct": false },
          { "text": "ネブライザー吸入", "correct": false }
        ]
      }
    },
    {
      "id": 3,
      "title": "退院・帰宅",
      "background": "home_living",
      "bgm": "daily",
      "cuts": [
        { "id": "s03_01", "speaker": "kazuo", "text": "やっと家に帰ってこられた。やっぱり自分の家が一番落ち着くな。", "characters": ["kazuo", "ichiko"], "expressions": [{"id": "kazuo", "position": "left", "expression": "kazuo_general_06_relieved"}, {"id": "ichiko", "position": "right", "expression": "ichiko_01_smile"}] },
        { "id": "s03_02", "speaker": "ichiko", "text": "お父さん、おかえりなさい。無理しないでね。ベッドの準備はしてあるから。", "characters": ["kazuo", "ichiko"], "expressions": [{"id": "kazuo", "position": "left", "expression": "kazuo_general_01_smile"}, {"id": "ichiko", "position": "right", "expression": "ichiko_01_smile"}] },
        { "id": "s03_03", "speaker": "kazuo", "text": "ありがとう。入院中は夜も眠れなかったから、今日はゆっくり休めそうだ。", "characters": ["kazuo", "ichiko"], "expressions": [{"id": "kazuo", "position": "left", "expression": "kazuo_general_09_grateful"}, {"id": "ichiko", "position": "right", "expression": "ichiko_01_smile"}] },
        { "id": "s03_04", "speaker": "ichiko", "text": "酸素の機械も業者さんが設置してくれたわ。使い方は覚えてる？", "characters": ["kazuo", "ichiko"], "expressions": [{"id": "kazuo", "position": "left", "expression": "kazuo_general_05_neutral"}, {"id": "ichiko", "position": "right", "expression": "ichiko_04_thinking"}] },
        { "id": "s03_05", "speaker": "kazuo", "text": "ああ、3年も使っているから大丈夫だよ。安静時は2リットル、動くときは4リットルに上げればいいんだろう？", "characters": ["kazuo", "ichiko"], "expressions": [{"id": "kazuo", "position": "left", "expression": "kazuo_general_01_smile"}, {"id": "ichiko", "position": "right", "expression": "ichiko_05_neutral"}] },
        { "id": "s03_06", "speaker": "ichiko", "text": "明日から訪問看護師さんが来てくれるって。週2回、火曜と木曜に来てくれるそうよ。", "characters": ["kazuo", "ichiko"], "expressions": [{"id": "kazuo", "position": "left", "expression": "kazuo_general_05_neutral"}, {"id": "ichiko", "position": "right", "expression": "ichiko_01_smile"}] }
      ],
      "knowledge": {
        "title": "在宅酸素療法（HOT）とは",
        "text": "Home Oxygen Therapyの略で、自宅で酸素吸入を行う治療法です。\n\n【機器の種類】\n・酸素濃縮器（主に自宅用）\n・液体酸素\n・携帯用ボンベ（外出用）\n\n【重要な注意点】\n・火気厳禁（2m以内）\n・酸素流量は医師の指示を守る\n・月1回の外来受診が必要"
      },
      "quiz": {
        "question": "在宅酸素療法について正しいのはどれか？",
        "options": [
          { "text": "酸素流量は自己判断で変更してよい", "correct": false },
          { "text": "酸素吸入中の喫煙は問題ない", "correct": false },
          { "text": "月1回以上の外来受診が必要である", "correct": true },
          { "text": "入浴中は酸素吸入を中止する", "correct": false }
        ]
      }
    },
    {
      "id": 4,
      "title": "訪問看護（初回）",
      "background": "home_bedroom",
      "bgm": "heartwarming",
      "cuts": [
        { "id": "s04_01", "speaker": "yamada", "text": "聖隷さん、はじめまして。訪問看護ステーションの山田です。今日からよろしくお願いします。", "characters": ["kazuo", "yamada"], "expressions": [{"id": "kazuo", "position": "left", "expression": "kazuo_general_05_neutral"}, {"id": "yamada", "position": "right", "expression": "yamada_01_smile"}] },
        { "id": "s04_02", "speaker": "kazuo", "text": "よろしくお願いします。こうして家に来てもらえると助かります。", "characters": ["kazuo", "yamada"], "expressions": [{"id": "kazuo", "position": "left", "expression": "kazuo_general_09_grateful"}, {"id": "yamada", "position": "right", "expression": "yamada_01_smile"}] },
        { "id": "s04_03", "speaker": "yamada", "text": "まず、お体の状態を確認させてくださいね。血圧と脈拍、酸素飽和度を測りますね。", "characters": ["kazuo", "yamada"], "expressions": [{"id": "kazuo", "position": "left", "expression": "kazuo_general_05_neutral"}, {"id": "yamada", "position": "right", "expression": "yamada_05_neutral"}] },
        { "id": "s04_04", "speaker": "yamada", "text": "血圧120の75、脈拍78回、SpO2は96%ですね。酸素2リットルで安定しています。", "characters": ["kazuo", "yamada"], "expressions": [{"id": "kazuo", "position": "left", "expression": "kazuo_medical_05_neutral"}, {"id": "yamada", "position": "right", "expression": "yamada_01_smile"}] },
        { "id": "s04_05", "speaker": "yamada", "text": "胸の音を聴かせてください。少しヒューヒューという音がしますね。痰は出ますか？", "characters": ["kazuo", "yamada"], "expressions": [{"id": "kazuo", "position": "left", "expression": "kazuo_medical_05_neutral"}, {"id": "yamada", "position": "right", "expression": "yamada_04_thinking"}] },
        { "id": "s04_06", "speaker": "kazuo", "text": "ええ、白っぽい痰が出ることはありますが、自分で出せています。", "characters": ["kazuo", "yamada"], "expressions": [{"id": "kazuo", "position": "left", "expression": "kazuo_general_05_neutral"}, {"id": "yamada", "position": "right", "expression": "yamada_05_neutral"}] },
        { "id": "s04_07", "speaker": "yamada", "text": "それは良かったです。痰の色が黄色や緑色に変わったり、熱が出たりしたら、すぐに連絡してくださいね。感染の兆候かもしれませんから。", "characters": ["kazuo", "yamada"], "expressions": [{"id": "kazuo", "position": "left", "expression": "kazuo_general_05_neutral"}, {"id": "yamada", "position": "right", "expression": "yamada_07_serious"}] }
      ],
      "knowledge": {
        "title": "COPDの呼吸音と観察ポイント",
        "text": "【聴診で聞こえる音】\n・笛声音（wheeze）：ヒューヒュー。気道狭窄\n・類鼾音（rhonchi）：グーグー。痰の貯留\n\n【急性増悪の徴候】\n・痰の量の増加、色の変化（膿性）\n・呼吸困難の悪化\n・発熱\n・全身倦怠感の増強"
      },
      "quiz": {
        "question": "COPD患者の酸素療法で正しいのはどれか？",
        "options": [
          { "text": "高濃度酸素を投与する", "correct": false },
          { "text": "CO2ナルコーシスに注意する", "correct": true },
          { "text": "SpO2 100%を目標とする", "correct": false },
          { "text": "酸素流量は患者の判断で調整する", "correct": false }
        ]
      }
    },
    {
      "id": 5,
      "title": "入浴介助",
      "background": "home_bedroom",
      "bgm": "heartwarming",
      "cuts": [
        { "id": "s05_01", "speaker": "yamada", "text": "聖隷さん、今日はお風呂に入りましょうか。奥様が準備してくださっていますね。", "characters": ["kazuo", "yamada", "ichiko"], "expressions": [{"id": "kazuo", "position": "left", "expression": "kazuo_general_05_neutral"}, {"id": "yamada", "position": "right", "expression": "yamada_01_smile"}] },
        { "id": "s05_02", "speaker": "ichiko", "text": "タオルと着替えは用意してあります。お風呂の温度は39度にしてあるわ。", "characters": ["kazuo", "yamada", "ichiko"], "expressions": [{"id": "kazuo", "position": "left", "expression": "kazuo_general_05_neutral"}, {"id": "ichiko", "position": "right", "expression": "ichiko_01_smile"}] },
        { "id": "s05_03", "speaker": "yamada", "text": "ありがとうございます。聖隷さん、入浴前に酸素を4リットルに上げておきましょうね。", "characters": ["kazuo", "yamada"], "expressions": [{"id": "kazuo", "position": "left", "expression": "kazuo_general_05_neutral"}, {"id": "yamada", "position": "right", "expression": "yamada_05_neutral"}] },
        { "id": "s05_04", "speaker": "kazuo", "text": "入浴は体力使うからね。苦しくならないか少し心配だな。", "characters": ["kazuo", "yamada"], "expressions": [{"id": "kazuo", "position": "left", "expression": "kazuo_general_02_worried"}, {"id": "yamada", "position": "right", "expression": "yamada_05_neutral"}] },
        { "id": "s05_05", "speaker": "yamada", "text": "ゆっくり入りましょう。洗髪や体を洗うのは私がお手伝いしますね。腕を上げる動作は息を吐きながら行いましょう。", "characters": ["kazuo", "yamada"], "expressions": [{"id": "kazuo", "position": "left", "expression": "kazuo_general_05_neutral"}, {"id": "yamada", "position": "right", "expression": "yamada_01_smile"}] },
        { "id": "s05_06", "speaker": "kazuo", "text": "久しぶりのお風呂だ。やっぱり気持ちいいな。一人だとなかなか入れないから、助かるなあ。", "characters": ["kazuo", "yamada"], "expressions": [{"id": "kazuo", "position": "left", "expression": "kazuo_general_06_relieved"}, {"id": "yamada", "position": "right", "expression": "yamada_01_smile"}] },
        { "id": "s05_07", "speaker": "yamada", "text": "お湯に浸かるのは5分程度にしておきましょう。長湯は心臓に負担がかかりますからね。", "characters": ["kazuo", "yamada"], "expressions": [{"id": "kazuo", "position": "left", "expression": "kazuo_general_05_neutral"}, {"id": "yamada", "position": "right", "expression": "yamada_05_neutral"}] }
      ],
      "knowledge": {
        "title": "COPD患者の入浴介助のポイント",
        "text": "【入浴介助の6つのポイント】\n①入浴前後で酸素流量を上げる\n②湯温は38-40度のぬるめに\n③長湯を避ける（5-10分程度）\n④洗髪時は前かがみを避ける\n⑤脱衣所と浴室の温度差に注意\n⑥入浴後は十分な休息を取る"
      },
      "quiz": {
        "question": "COPD患者の入浴介助で正しいのはどれか？",
        "options": [
          { "text": "42度以上の熱い湯に入れる", "correct": false },
